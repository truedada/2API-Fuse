# ========================================
# Docker 环境变量配置
# ========================================
# 使用说明:
# 1. 复制此文件为 .env: cp .env.docker .env
# 2. 根据需要修改配置
# 3. 启动服务: docker-compose up -d
#
# 注意事项:
# - Docker 环境中，MYSQL_SERVER 应设为 "mysql" (服务名)
# - Docker 环境中，REDIS_HOST 应设为 "redis" (服务名)
# - 生产环境务必修改 SECRET_KEY 和密码等敏感信息

# ========================================
# 基础配置
# ========================================
HOST=0.0.0.0
PORT=40223
ENVIRONMENT=prod
DEBUG=False

# ========================================
# 跨域配置
# ========================================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ========================================
# 安全配置
# ========================================
# 生产环境请务必修改 SECRET_KEY (可使用 openssl rand -hex 32 生成)
SECRET_KEY=2f0e33bc7fe570550e207cdeca01a8851ad8ec9c88e480b1a171f29aae77f531
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ADMIN_TOKEN=

# ========================================
# 数据库配置
# ========================================
# 数据库类型: sqlite 或 mysql
DB_TYPE=sqlite

# SQLite 配置
SQLITE_FILE=/app/data/db.sqlite3

# MySQL 配置 (当 DB_TYPE=mysql 时使用)
# 注意: Docker 环境中 MYSQL_SERVER 必须设为 "mysql" (容器服务名)
MYSQL_SERVER=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=2api_db

# ========================================
# Redis 配置
# ========================================
# 是否使用 Redis
USE_REDIS=True

# 注意: Docker 环境中 REDIS_HOST 必须设为 "redis" (容器服务名)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# Google OAuth 配置
# ========================================
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_REDIRECT_URI=http://localhost:8081

# Gemini CLI 凭据
GEMINICLI_CLIENT_ID=
GEMINICLI_CLIENT_SECRET=

# Antigravity 凭据
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# ========================================
# 其他配置
# ========================================
USE_CLOUDFLARE=False
PROXY_URL=

